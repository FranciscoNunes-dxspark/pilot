{
  "name": "pilot",
  "version": "0.2.0",
  "private": true,
  "description": "An ASP.NET MVC project mapped for Claude Code: controllers, views, layouts, partials, components, bundles, TypeScript, JavaScript and LESS as one graph, asked through a CLI or an MCP server",
  "type": "module",
  "bin": {
    "pilot": "bin/pilot.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/pilot.js",
    "test": "node --import ./src/app.js --test --test-concurrency=3 test/*.test.js",
    "build": "npx --yes bun@1.4.2 scripts/build.js",
    "build:all": "npx --yes bun@1.4.2 scripts/build.js --all"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/FranciscoNunes-dxspark/pilot.git"
  },
  "homepage": "https://github.com/FranciscoNunes-dxspark/pilot",
  "bugs": "https://github.com/FranciscoNunes-dxspark/pilot/issues",
  "license": "MIT"
}
